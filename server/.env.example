# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas — requiere replica set por transacciones (ver modelo-datos-turnos.md §11)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Twilio — WhatsApp Business Platform
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+549XXXXXXXXXX

# Mail (proveedor con tier gratuito)
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=no-responder@centro.com

# JWT — sesión del panel (admin / profesional)
JWT_SECRET=
JWT_EXPIRES_IN=8h
