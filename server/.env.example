# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas — requiere replica set por transacciones (ver modelo-datos-turnos.md §11)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Twilio — WhatsApp Business Platform
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+549XXXXXXXXXX

# Mail (proveedor con tier gratuito)
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=no-responder@centro.com

# Sesión del panel (admin / profesional) — server-side, cookie httpOnly, sin JWT.
# Acepta una lista separada por comas para rotar sin invalidar sesiones activas
# (el primero firma sesiones nuevas, todos se prueban al leer cookies existentes).
SESSION_SECRET=
# Orígenes permitidos por CORS (panel + web pública), separados por coma —
# nunca '*' (incompatible con credentials:true). Si no está seteada, cae a
# PANEL_ORIGIN (compat, un solo origen) y si tampoco está, al default de dev
# (localhost:5173 panel + localhost:5174 pública).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Compat: origen único, usado sólo si CORS_ORIGINS no está seteada. No hace
# falta setear los dos — preferir CORS_ORIGINS en instalaciones nuevas.
PANEL_ORIGIN=http://localhost:5173

# Seed idempotente del admin (npm run seed:admin --workspace=server) — no hay
# ruta pública de registro.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
